                "template": {
                  "name": "Card",
                  "model": "card"
                }
              }
            }
          }
        },
        {
          "title": "Columns",
          "id": "columns",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/columns/v1/columns",
                "template": {
                  "columns": "2",
                  "rows": "1"
                }
              }
            }
          }
        },
        {
          "title": "Fragment",
          "id": "fragment",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Fragment",
                  "model": "fragment"
                }
              }
            }
          }
        },
        {
          "title": "Hero",
          "id": "hero",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Hero",
                  "model": "hero"
                }
              }
            }
          }
        },
        {
          "title": "PDP Removable Batteries",
          "id": "pdp-removable-batteries",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "PDP Removable Batteries",
                  "filter": "pdp-removable-batteries",
                  "model": "pdp-removable-batteries"
                }
              }
            },
            "da": {
              "name": "pdp-removable-batteries",
              "rows": 7,
              "columns": 1,
              "fields": [
                {
                  "name": "mobileImage",
                  "selector": "div:nth-child(1)"
                },
                {
                  "name": "desktopImage",
                  "selector": "div:nth-child(2)"
                },
                {
                  "name": "desktopImageAlt",
                  "selector": "div:nth-child(3)"
                },
                {
                  "name": "heading",
                  "selector": "div:nth-child(4)"
                },
                {
                  "name": "subheading",
                  "selector": "div:nth-child(5)"
                },
                {
                  "name": "ctaLabel",
                  "selector": "div:nth-child(6)"
                },
                {
                  "name": "ctaLink",
                  "selector": "div:nth-child(7)"
                }
              ]
            }
          }
        },
        {
          "title": "PDP Removable Batteries Card",
          "id": "pdp-removable-batteries-card",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block/item",
                "template": {
                  "name": "PDP Removable Batteries Card",
                  "model": "pdp-removable-batteries-card"
                }
              }
            },
            "da": {
              "name": "pdp-removable-batteries-card",
              "rows": 1,
              "columns": 3,
              "fields": [
                {
                  "name": "title",
                  "selector": "div:nth-child(1)"
                },
                {
                  "name": "description",
                  "selector": "div:nth-child(2)"
                },
                {
                  "name": "icon",
                  "selector": "div:nth-child(3)"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}